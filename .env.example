# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo servidor, nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Si Supabase muestra "publishable key" en vez de "anon key", usa esta variable:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direccion publica del sistema, para armar el enlace de seguimiento que recibe el cliente por WhatsApp.
# En Vercel (Production): https://optica-perez.vercel.app (o el dominio propio de la optica). Sin barra final.
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business (Meta Cloud API). Solo en Vercel como "Sensitive"; nunca en el repositorio.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Opcional (por defecto v23.0)
WHATSAPP_API_VERSION=
